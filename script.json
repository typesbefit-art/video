  "lines": [
    {"who": "driver", "text": "Подъехал. Серая машина у подъезда.", "pause_after": 0.3},
    {"who": "passenger", "text": "Вижу красную.", "pause_after": 0.3},
    {"who": "driver", "text": "Серая. Просто красная ей идёт.", "pause_after": 0.4},
    {"who": "passenger", "text": "Ладно, выхожу.", "pause_after": 0.3},
    {"who": "driver", "text": "Только дверью не хлопайте. Она у меня нервная.", "pause_after": 0.4},
    {"who": "passenger", "text": "Мне на вокзал. По навигатору двадцать минут.", "pause_after": 0.3},
    {"who": "driver", "text": "Навигатор для слабых. Поеду по интуиции.", "pause_after": 0.4},
    {"who": "passenger", "text": "А интуиция знает дорогу?", "pause_after": 0.3},
    {"who": "driver", "text": "Знает. Иногда даже знает, где вокзал.", "pause_after": 0.3},
    {"who": "passenger", "text": "Иногда?!", "pause_after": 0.3},
    {"who": "driver", "text": "Не волнуйтесь. Мы с ней уже в трёх районах заблудились. Ни разу не опоздали. Почти.", "pause_after": 0.4},
    {"who": "passenger", "text": "А почему мы повернули налево?", "pause_after": 0.3, "route": "jump"},
    {"who": "driver", "text": "Там красивее.", "pause_after": 0.3},
    {"who": "passenger", "text": "Мне не красиво надо, мне надо вовремя!", "pause_after": 0.3},
    {"who": "driver", "text": "Так и знал, что вы человек без романтики.", "pause_after": 0.4},
    {"who": "passenger", "text": "Включите навигатор. Пожалуйста.", "pause_after": 0.3},
    {"who": "driver", "text": "Включил. Он тоже говорит налево.", "pause_after": 0.3},
    {"who": "passenger", "text": "Тогда зачем...", "pause_after": 0.3},
    {"who": "driver", "text": "Хотел сделать вид, что я сам умный.", "pause_after": 0.5},
    {"who": "driver", "text": "Приехали. Вокзал.", "pause_after": 0.3, "route": "arrive"},
    {"who": "passenger", "text": "Серьёзно? Я думала, мы заблудились.", "pause_after": 0.3},
    {"who": "driver", "text": "Заблудились. Но вокзал сам нас нашёл.", "pause_after": 0.4},
    {"who": "passenger", "text": "Ставлю пять звёзд.", "pause_after": 0.3},
    {"who": "driver", "text": "А чаевые?", "pause_after": 0.3},
    {"who": "passenger", "text": "Звёзды и есть чаевые.", "pause_after": 0.3}
  ]
}
