[
 {
  "text": "Туман над мостом.",
  "start": 0.35,
  "end": 1.532
 },
 {
  "text": "Двое.",
  "start": 1.873,
  "end": 2.458
 },
 {
  "text": "Ни слова.",
  "start": 2.8,
  "end": 3.578
 },
 {
  "text": "Лишь ветер и холод стали.",
  "start": 3.919,
  "end": 5.75
 },
 {
  "text": "Клинки покидают ножны.",
  "start": 6.35,
  "end": 7.647
 },
 {
  "text": "Первый удар.",
  "start": 7.924,
  "end": 8.664
 },
 {
  "text": "Блок.",
  "start": 8.942,
  "end": 9.416
 },
 {
  "text": "Искры во тьме.",
  "start": 9.693,
  "end": 10.486
 },
 {
  "text": "Каждое движение может стать последним.",
  "start": 10.764,
  "end": 12.75
 },
 {
  "text": "Шаг в сторону.",
  "start": 13.35,
  "end": 14.336
 },
 {
  "text": "Разворот.",
  "start": 14.59,
  "end": 15.275
 },
 {
  "text": "Сталь режет воздух у самого лица.",
  "start": 15.529,
  "end": 17.812
 },
 {
  "text": "Один пропускает удар, но остаётся стоять.",
  "start": 18.066,
  "end": 20.75
 },
 {
  "text": "Последний выпад.",
  "start": 21.35,
  "end": 22.426
 },
 {
  "text": "Тишина.",
  "start": 23.165,
  "end": 23.788
 },
 {
  "text": "Секунда, длиннее всей жизни.",
  "start": 24.527,
  "end": 26.75
 },
 {
  "text": "Один клинок падает.",
  "start": 27.05,
  "end": 28.228
 },
 {
  "text": "Рассвет.",
  "start": 28.368,
  "end": 28.941
 },
 {
  "text": "Бой окончен.",
  "start": 29.081,
  "end": 29.95
 }
]