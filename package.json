{
  "name": "nuclear-war-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Вертикальное видео (Reels/Shorts) «Что если наступит ядерная война» на Remotion",
  "scripts": {
    "check-audio": "tsx scripts/check-audio.ts",
    "predev": "npm run check-audio",
    "dev": "remotion studio src/index.ts",
    "align": "npm run check-audio && tsx scripts/align.ts",
    "prerender": "npm run check-audio",
    "render": "remotion render src/index.ts Main out/video.mp4 --codec=h264 --audio-codec=aac",
    "still": "remotion still src/index.ts Main out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.2.6",
    "@remotion/cli": "^4.0.541",
    "@remotion/noise": "^4.0.541",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
